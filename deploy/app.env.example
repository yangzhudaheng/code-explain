# 服务器上的生产配置。systemd 通过 EnvironmentFile 读取，进程启动时作为环境变量注入。
# 这个文件里有密钥：上传后 chmod 600，绝不提交到仓库。

# ---- 数据库：Neon（新加坡）----
# 形如 postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
DB_POOL_SIZE=4

# ---- 会话与加密 ----
# JWT_SECRET: openssl rand -base64 48 生成；少于 32 字节会拒绝启动
JWT_SECRET=
# APP_ENC_KEY: openssl rand -base64 32 生成（M4 存用户模型 API Key 用）
APP_ENC_KEY=

# ---- 邮件：QQ 邮箱 465 隐式 SSL ----
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- 站点地址：用在验证码邮件里的链接，填 http://服务器IP:8080 ----
APP_BASE_URL=

# ---- 两个开关，错了会直接出问题 ----
# 走 http（无证书）时必须是 false，否则浏览器丢弃 Cookie，登录后立刻掉线
COOKIE_SECURE=false
# 生产必须 false，否则图形码答案会被打进日志
CAPTCHA_DEBUG=false
