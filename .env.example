# 复制为 .env 后填入真实值；.env 已在 .gitignore 中
# 注意：不要把任何真实密钥写进这个文件并提交

# ---- 数据库（二选一）----------------------------------------------------
# 方式 1（推荐，Neon / Vercel 集成自动注入）：整条连接串，支持 postgres:// 写法
DATABASE_URL=
# 方式 2：分散三件套，DB_URL 必须是 jdbc:postgresql:// 开头
DB_URL=
DB_USER=
DB_PASSWORD=
# 仅用于「先验证容器能启动、还没接数据库」的冒烟场景，正常部署必须留空/false
DB_OPTIONAL=false
# 连接池大小；Vercel 每个实例一个 JVM，Neon 免费版连接数有限，别调大
DB_POOL_SIZE=4

# ---- 认证（M2 使用）----------------------------------------------------
JWT_SECRET=
APP_ENC_KEY=

# ---- 邮件（M2 使用，QQ 邮箱走 465 SSL）---------------------------------
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

APP_BASE_URL=http://localhost:8080
APP_PROFILE=dev
